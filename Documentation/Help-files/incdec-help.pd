#N canvas 600 90 620 620 modes 0;
#X text 30 20 Three switches change how the object behaves. Each has a message and a matching creation flag., f 64;
#X text 30 62 'repeat' turns on autorepeat: hold the button down and it keeps stepping \, after a short pause \, until you let go. Without it one click is one step., f 64;
#X obj 30 120 tgl 19 0 empty empty empty 17 7 0 10 #dcdcdc #000000 #000000 0 1;
#X msg 60 120 repeat \$1;
#X obj 30 155 else/incdec -range 0 100;
#X obj 30 210 else/display;
#X text 140 122 hold it down, f 20;
#X text 30 250 'relative' stops it keeping a count: the upper half sends 1 and the lower half sends -1 \, which is what you want when something downstream is doing the counting., f 64;
#X obj 30 308 tgl 19 0 empty empty empty 17 7 0 10 #dcdcdc #000000 #000000 0 1;
#X msg 60 308 relative \$1;
#X obj 30 343 else/incdec;
#X obj 30 398 else/display;
#X text 150 310 1 up \, -1 down, f 24;
#X text 30 438 'horizontal' lays the two halves out side by side instead of stacked: the right half increments and the left half decrements. Give it a wide \, short size to match., f 64;
