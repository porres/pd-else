#X text 50 88 [tab] is a row of tab buttons. Click a tab to select it and output its index \, counting from 0 The tabs share the object's width evenly \, so making the object wider gives every tab more room for its label., f 66;
#X text 50 145 click a tab =>;
#X obj 150 141 else/tab 220 25 4 -labels sine saw square noise;
#X floatatom 150 190 7 0 0 0 - - - 0;
#X text 205 190 index of the selected tab;
#N canvas 202 161 1400 688 labels 0;
#X text 30 20 Set every label at once with the 'labels' message \, or a single one with 'label' followed by the tab index (counting from 0) and the new text., f 56;
#X text 30 78 The number of tabs is set with the 'tabs' message or the '-ntabs' flag. Changing the number of tabs keeps the labels that are still in range and fills the rest with 'tab1' \, 'tab2' and so on., f 56;
#X obj 30 300 else/tab 300 24 3 -labels low mid high;
#X obj 30 355 else/display;
#X msg 30 155 labels low mid high;
#X msg 30 180 labels red green blue;
#X msg 30 205 label 1 middle;
#X msg 30 230 label 0 bottom;
#X msg 248 258 tabs 5;
#X msg 303 258 tabs 3;
#X msg 358 258 tabs 8;
#X text 230 155 set all labels, f 24;
#X text 230 205 set one label, f 24;
#X text 80 258 set the number of tabs =>, f 26;
