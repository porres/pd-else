#X text 93 52 -height <float>: sets height in pixels (default 25), f 76;
#X text 93 67 -ntabs <float>: sets the number of tabs (default 3), f 76;
#X text 93 82 -mode <float>: non zero outputs the label instead of the index (default 0), f 76;
#X text 93 97 -labels <list>: sets the tab labels (default tab1 tab2 tab3 ...), f 76;
#X text 93 112 -savestate <float>: non zero sets to save state mode (default 0), f 76;
#X text 93 127 -bgcolor <f \, f \, f>: sets background color in RGB, f 76;
