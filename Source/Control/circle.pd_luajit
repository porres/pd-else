local else_gui = require("else_gui")
local circle   = pd.Class:new():register("circle")

-- Parse a hex color string that MUST start with '#'.
-- Accepts "#RRGGBB" or "#RGB"; returns {r, g, b}, or nil if invalid.
-- Defined before else_gui.setup so the color-flag handlers can use it.
local function hex_to_rgb(hex)
    if type(hex) ~= "string" then return nil end
    if hex:sub(1, 1) ~= "#" then return nil end   -- require leading '#'
    hex = hex:sub(2)
    if #hex == 3 then                              -- expand shorthand: "f80" -> "ff8800"
        hex = hex:gsub("(.)", "%1%1")
    end
    if #hex ~= 6 then return nil end
    local r = tonumber(hex:sub(1, 2), 16)
    local g = tonumber(hex:sub(3, 4), 16)
    local b = tonumber(hex:sub(5, 6), 16)
    if not (r and g and b) then return nil end
    return { r, g, b }
end

else_gui.setup(circle, {
    { "size",           127,          "on_resize", "Size",             "int",   {frame="Dimensions", ncols=1, flag="size", min=10, max=4096} },
    { "xrange",         {-1, 1},      "repaint",   "X Range",          "range", {frame="General", flag="xrange"}},
    { "yrange",         {-1, 1},      "repaint",   "Y Range",          "range", {frame="General", flag="yrange"}},
    { "mode",           1,            "repaint",   "Mode",             "combo", {frame="General", flag="mode", items={"none", "crosshair", "line to center"}} },
    { "bgcolor1",       pd.bg_color,  "repaint",   "Background",       "color", {frame="Appearance", ncols=3, flag="bgcolor1", msg="bgcolor1", theme="bg"} },
    { "bgcolor2",       pd.bg_color,  "repaint",   "Circle",           "color", {frame="Appearance", flag="bgcolor2", msg="bgcolor2", theme="bg"} },
    { "fgcolor",        pd.fg_color,  "repaint",   "Foreground",       "color", {frame="Appearance", flag="fgcolor", msg="fgcolor", theme="fg"} },
    { "grid",           1,            "repaint",   "Grid",             "check", {frame="General", flag="grid"}},
    { "jump",           0,            nil,         "Jump on Click",    "check", {frame="General", flag="jump"}},
    { "savestate",      0,            "record_init","Save State",      "check", {frame="General", flag="savestate"}},
    { "init_x",         0,            nil,         nil,                "float" },
    { "init_y",         0,            nil,         nil,                "float" },
    { "send",           "empty",      nil,         "Send",             "text",  {frame="General", flag="send", dollar=true}},
    { "receive",        "empty",      "on_receive","Receive",          "text",  {frame="General", flag="receive", dollar=true}},
    { "clip",           1,            "repaint",   "Clip to Circle",   "check", {frame="General", flag="clip"}},
    -- appended so that the positional argument order above never changes
    { "usetheme",    0, "repaint", "Use Theme Colors", "check", {frame="Appearance", order=0, flag="usetheme"} },
    -- what is transparent: the background square only, or the circle too
    { "transparent", 0, "repaint", "Transparent",      "combo", {frame="Appearance", order=0, flag="transparent", items={"none", "background", "all"}} },
}, {["-range"] = function(self, atoms, i)
        self.xrange[1], self.yrange[2] = tonumber(atoms[i]),   tonumber(atoms[i])
        self.xrange[2], self.yrange[1] = tonumber(atoms[i+1]), tonumber(atoms[i+1])
        return 2
    end,
    -- xrange / yrange set x and y ranges independently. The y range is
    -- stored inverted internally (yrange[2] = lo, yrange[1] = hi), the
    -- same way -range stores it, so -range lo hi and -xrange lo hi
    -- -yrange lo hi produce the same result.
    ["-xrange"] = function(self, atoms, i)
        local v = else_gui.numbers(atoms, i, 2)
        if v[1] then self.xrange[1] = v[1] end
        if v[2] then self.xrange[2] = v[2] end
        return #v
    end,
    ["-yrange"] = function(self, atoms, i)
        local v = else_gui.numbers(atoms, i, 2)
        if v[1] then self.yrange[2] = v[1] end
        if v[2] then self.yrange[1] = v[2] end
        return #v
    end,
    -- given bare, the background is transparent, as with the other GUIs
    ["-transparent"] = function(self, atoms, i)
        local v = else_gui.numbers(atoms, i, 1)
        self.transparent = v[1] and math.floor(v[1]) or 1
        return #v
    end,
    ["-theme"] = function(self, atoms, i)
        self.usetheme = 1
        return 0
    end,
    -- size <f>: both axes to the same value, clamped to the property limits
    ["-size"] = function(self, atoms, i)
        local v = else_gui.numbers(atoms, i, 1)
        if v[1] then
            self.size = math.max(10, math.min(4096, math.floor(v[1])))
        end
        return #v
    end,
    -- mode <f>: visibility mode 0-2 (none / crosshair / line to center)
    ["-mode"] = function(self, atoms, i)
        local v = else_gui.numbers(atoms, i, 1)
        if v[1] then
            self.mode = math.max(0, math.min(2, math.floor(v[1])))
        end
        return #v
    end,
    -- bare flags: no value consumed
    ["-nogrid"] = function(self, atoms, i)
        self.grid = 0
        return 0
    end,
    ["-noclip"] = function(self, atoms, i)
        self.clip = 0
        return 0
    end,
    ["-savestate"] = function(self, atoms, i)
        self.savestate = 1
        return 0
    end,
    -- hex-only color flags: each takes exactly one '#RRGGBB' / '#RGB' symbol.
    -- An invalid hex is skipped; the flag still consumes its one atom.
    ["-bgcolor"] = function(self, atoms, i)
        local c = hex_to_rgb(atoms[i])
        if c then
            self.bgcolor1 = c
            self.bgcolor2 = { c[1], c[2], c[3] }
            self.usetheme = 0
        end
        return 1
    end,
    ["-bgcolor1"] = function(self, atoms, i)
        local c = hex_to_rgb(atoms[i])
        if c then
            self.bgcolor1 = c
            self.usetheme = 0
        end
        return 1
    end,
    ["-bgcolor2"] = function(self, atoms, i)
        local c = hex_to_rgb(atoms[i])
        if c then
            self.bgcolor2 = c
            self.usetheme = 0
        end
        return 1
    end,
    ["-fgcolor"] = function(self, atoms, i)
        local c = hex_to_rgb(atoms[i])
        if c then
            self.fgcolor = c
            self.usetheme = 0
        end
        return 1
    end
    }
    )

-- Strict validator for a color message from the inlet.
-- Accepts exactly one of:
--   * a single symbol atom beginning with '#'
--   * exactly three number atoms, each in [0, 255]
-- Anything else returns nil.
local function color_from_atoms(atoms)
    if #atoms == 1 and type(atoms[1]) == "string" then
        return hex_to_rgb(atoms[1])
    end
    if #atoms == 3
       and type(atoms[1]) == "number"
       and type(atoms[2]) == "number"
       and type(atoms[3]) == "number" then
        local r, g, b = atoms[1], atoms[2], atoms[3]
        if r >= 0 and r <= 255
           and g >= 0 and g <= 255
           and b >= 0 and b <= 255 then
            return { r, g, b }
        end
    end
    return nil
end

-- Reject any restored color that is not a {r, g, b} of numbers 0-255.
-- This cleans up older patches that saved e.g. {554433, 0, 0}.
local function sanitize_color(c)
    if type(c) == "table"
       and type(c[1]) == "number"
       and type(c[2]) == "number"
       and type(c[3]) == "number"
       and c[1] >= 0 and c[1] <= 255
       and c[2] >= 0 and c[2] <= 255
       and c[3] >= 0 and c[3] <= 255 then
        return { c[1], c[2], c[3] }
    end
    return { 0, 0, 0 }
end

function circle:initialize(sel, atoms)
    self.inlets   = 1
    self.outlets  = 1
    self.shift    = 0
    self.dragging = false

    self:init_args(atoms)

    -- drop any malformed color state inherited from older saves
    self.bgcolor1 = sanitize_color(self.bgcolor1)
    self.bgcolor2 = sanitize_color(self.bgcolor2)
    self.fgcolor  = sanitize_color(self.fgcolor)

    if self.savestate ~= 0 then
        self.slider_position_x = self.init_x
        self.slider_position_y = self.init_y
    else
        self.slider_position_x = 0.5
        self.slider_position_y = 0.5
    end

    self:setup_receive(self.receive)
    self:set_size(self.size, self.size)
    return true
end

function circle:in_1_theme(atoms)
    local v = tonumber(atoms[1])
    if v == nil then return end
    self.usetheme = v ~= 0 and 1 or 0
    self:save_args()
    self:repaint()
end

function circle:in_1_bgcolor(atoms)
    local c = color_from_atoms(atoms)
    if not c then return end
    self.bgcolor1 = c
    self.bgcolor2 = { c[1], c[2], c[3] }
    self.usetheme = 0   -- an explicit color means: use this color
    self:save_args(); self:repaint()
end

-- Background square only:  bgcolor1 #RRGGBB  or  bgcolor1 r g b
-- (also the method the "Background" color swatch sends)
function circle:in_1_bgcolor1(atoms)
    local c = color_from_atoms(atoms)
    if not c then return end
    self.bgcolor1 = c
    self.usetheme = 0   -- an explicit color means: use this color
    self:save_args(); self:repaint()
end

-- Circle face only:  bgcolor2 #RRGGBB  or  bgcolor2 r g b
-- (also the method the "Circle" color swatch sends)
function circle:in_1_bgcolor2(atoms)
    local c = color_from_atoms(atoms)
    if not c then return end
    self.bgcolor2 = c
    self.usetheme = 0   -- an explicit color means: use this color
    self:save_args(); self:repaint()
end

-- Both background colors + foreground in one shot:
--   colors #RRGGBB #RRGGBB
-- First hex sets bgcolor1 AND bgcolor2 (like "bgcolor"),
-- second hex sets fgcolor.  Only two hex symbols are accepted.
function circle:in_1_colors(atoms)
    if #atoms ~= 2 then return end
    if type(atoms[1]) ~= "string" or type(atoms[2]) ~= "string" then return end
    local c1 = hex_to_rgb(atoms[1])
    local c2 = hex_to_rgb(atoms[2])
    if not c1 or not c2 then return end
    self.bgcolor1 = c1
    self.bgcolor2 = { c1[1], c1[2], c1[3] }
    self.fgcolor  = c2
    self.usetheme = 0   -- an explicit color means: use this color
    self:save_args(); self:repaint()
end

function circle:in_1_fgcolor(atoms)
    local c = color_from_atoms(atoms)
    if not c then return end
    self.fgcolor = c
    self.usetheme = 0   -- an explicit color means: use this color
    self:save_args(); self:repaint()
end

function circle:in_1_range(atoms)
    local lo, hi = tonumber(atoms[1]), tonumber(atoms[2])
    if lo then self.xrange[1], self.yrange[2] = lo, lo end
    if hi then self.xrange[2], self.yrange[1] = hi, hi end
    self:save_args(); self:repaint()
end

function circle:key(down, name)
    if name == "Shift_L" then
        self.shift = down
    end
end

function circle:on_resize(sym)
    self:set_size(self.size, self.size)
end

function circle:on_receive(sym)
    self:setup_receive(sym)
end

function circle:scale(norm, lo, hi)
    return lo + (hi - lo) * norm
end

function circle:unscale(val, lo, hi)
    return (val - lo) / (hi - lo)
end

-- While we output, what comes back in through the receive name is dropped,
-- and an answer to [retrieve] isn't sent (see receive_cb in else_gui).
function circle:output()
    local outer = self._outputting
    self._outputting = true
    local x = self:scale(self.slider_position_x, self.xrange[1], self.xrange[2])
    local y = self:scale(self.slider_position_y, self.yrange[2],   self.yrange[1])
    self:outlet(1, "list", {x, y})
    if self.send ~= "" and self.send ~= "empty" and not self._retrieving then
        pd.send(self:realize_symbol(self.send), "list", {x, y})
    end
    self._outputting = outer   -- outputs can nest, so restore
end

function circle:record_init()
    if self.savestate ~= 0 then
        self.init_x = self.slider_position_x
        self.init_y = self.slider_position_y
        self:save_args()
    end
end

function circle:clamp_position()
    if self.clip ~= 0 then
        local dx = self.slider_position_x - 0.5
        local dy = self.slider_position_y - 0.5

        local dist = math.sqrt(dx*dx + dy*dy)
        if dist > 0.5 then
            local scale = 0.5 / dist
            dx = dx * scale
            dy = dy * scale
        end

        self.slider_position_x = dx + 0.5
        self.slider_position_y = dy + 0.5
    else
        self.slider_position_x = math.max(0, math.min(1, self.slider_position_x))
        self.slider_position_y = math.max(0, math.min(1, self.slider_position_y))
    end
end

function circle:mouse_down(x, y)
    local w, h = self:get_size()
    self.dragging = true
    self.last_mouse_x = x
    self.last_mouse_y = y

    if self.jump == 1 then
        self.slider_position_x =  x / w
        self.slider_position_y = y / h
        self:clamp_position()
        self:repaint(); self:output()
    end
end

function circle:mouse_drag(x, y)
    if not self.dragging then return end
    local w, h = self:get_size()

    local dx = x - self.last_mouse_x
    local dy = y - self.last_mouse_y
    if self.shift ~= 0 then dx, dy = dx / 10, dy / 10 end

    self.slider_position_x = self.slider_position_x + dx / w
    self.slider_position_y = self.slider_position_y + dy / h

    self:clamp_position()
    self:repaint(); self:output()

    self.last_mouse_x = x
    self.last_mouse_y = y
end

function circle:mouse_up()
    self.dragging = false
    self:record_init()
end

function circle:in_1_bang()
    self:output()
end

function circle:in_1_list(atoms)
    self.slider_position_x = self:unscale(tonumber(atoms[1]) or 0, self.xrange[1], self.xrange[2])
    self.slider_position_y = self:unscale(tonumber(atoms[2]) or 0, self.yrange[2], self.yrange[1])
    self:clamp_position()
    self:repaint(); self:output(); self:record_init()
end

function circle:in_1_set(atoms)
    self.slider_position_x = self:unscale(tonumber(atoms[1]) or 0, self.xrange[1], self.xrange[2])
    self.slider_position_y = self:unscale(tonumber(atoms[2]) or 0, self.yrange[2], self.yrange[1])
    self:clamp_position()
    self:repaint(); self:record_init()
end

function circle:set_color_from(g, c)
    g:set_color(c[1], c[2], c[3])
end

function circle:paint(g)
    local w, h = self:get_size()
    local px =  self.slider_position_x * w
    local py =  self.slider_position_y * h

    -- background square
    self:fill_background(g, "bgcolor1")

    -- circle face
    if self.transparent ~= 2 then
        self:set_color_from(g, self:color("bgcolor2"))
        g:fill_ellipse(1, 1, w - 1, h - 1)
    end

    -- grid lines
    self:set_color_from(g, self:color("fgcolor"))
    if self.grid ~= 0 then
        g:draw_line(w/2, 0,  w/2, h,   1)
        g:draw_line(0,  h/2,  w, h/2,  1)
    end

    -- mode lines
    if self.mode == 1 then
        g:draw_line(px, py, px, h/2, 2)
        g:draw_line(px, py, w/2, py, 2)
    elseif self.mode == 2 then
        g:draw_line(px, py, w/2, h/2, 2)
    end

    -- circle border
    g:stroke_ellipse(1, 1, w - 1, h - 1, 1)

    -- handle
    g:fill_ellipse(px - 3.5, py - 3.5, 7, 7)

    -- for plugdata dynamic resize
    if w ~= self.size then
        self.size = w
        self:save_args()
    end
end
