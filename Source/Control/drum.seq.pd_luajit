local else_gui = require("else_gui")
local drum_seq  = pd.Class:new():register("drum.seq")

-- Parse "#RRGGBB" or "#RGB" (leading # REQUIRED); returns {r,g,b} or nil.
-- Defined before else_gui.setup so the color-flag handlers can use it.
local function hex_to_rgb(hex)
    if type(hex) ~= "string" then return nil end
    if hex:sub(1, 1) ~= "#" then return nil end
    hex = hex:sub(2)
    if #hex == 3 then hex = hex:gsub("(.)", "%1%1") end
    if #hex ~= 6 then return nil end
    local r = tonumber(hex:sub(1, 2), 16)
    local g = tonumber(hex:sub(3, 4), 16)
    local b = tonumber(hex:sub(5, 6), 16)
    if not (r and g and b) then return nil end
    return { r, g, b }
end

else_gui.setup(drum_seq, {
    { "tracks",     2,             "on_grid",     "Tracks",        "int",   {frame="Dimensions", min=1, max=64,  flag="tracks"} },
    { "slots",      8,             "on_grid",     "Slots",         "int",   {frame="Dimensions", min=1, max=256, flag="slots"}  },
    { "cell_size",  20,            "on_resize",   "Cell Size",     "int",   {frame="Dimensions", min=4, max=128, flag="size"}   },
    { "embed",      0,             "save_state",  "Embed",         "check", {frame="Dimensions", flag="embed" }                 },
    -- 11 dummy positional placeholders to match the original arg layout
    { "_d1", 0 }, { "_d2", 0 }, { "_d3", 0 }, { "_d4", 0 }, { "_d5", 0 },
    { "_d6", 0 }, { "_d7", 0 }, { "_d8", 0 }, { "_d9", 0 }, { "_d10", 0 }, { "_d11", 0 },
    { "content",    {},            nil,           nil,             "float", {consume="slots*tracks"} },
    { "bgcolor",    {255, 255, 255},   "repaint",     "Background",    "color", {frame="Appearance", flag="bgcolor", theme="bg"}     },
    { "gridcolor",  {0, 0, 0},   "repaint",     "Grid",          "color", {frame="Appearance", flag="gridcolor", theme="fg"}  },
    { "fgcolor",{128,128,159}, "repaint",     "Foreground",   "color", {frame="Appearance", flag="fgcolor", theme="sel"} },
    { "flashcolor", {200, 0, 0},  "repaint",     "Flash",         "color", {frame="Appearance", flag="flashcolor", theme="gop"} },
    -- appended so that the positional argument order above never changes
    { "usetheme",    0, "repaint", "Use Theme Colors", "check", {frame="Appearance", order=0, flag="usetheme"} },
    { "transparent", 0, "repaint", "Transparent",      "check", {frame="Appearance", order=0, flag="transparent"} },
}, {
    ["-embed"] = function(self, atoms, i)
        self.embed = 1
        return 0
    end,
    ["-theme"] = function(self, atoms, i)
        self.usetheme = 1
        return 0
    end,
    -- numeric flags: each consumes one atom
    ["-tracks"] = function(self, atoms, i)
        local v = else_gui.numbers(atoms, i, 1)
        if v[1] then
            self.tracks = math.max(1, math.min(64, math.floor(v[1])))
        end
        return #v
    end,
    ["-slots"] = function(self, atoms, i)
        local v = else_gui.numbers(atoms, i, 1)
        if v[1] then
            self.slots = math.max(1, math.min(256, math.floor(v[1])))
        end
        return #v
    end,
    ["-size"] = function(self, atoms, i)
        local v = else_gui.numbers(atoms, i, 1)
        if v[1] then
            self.cell_size = math.max(4, math.min(128, math.floor(v[1])))
        end
        return #v
    end,
    -- bare flag: background becomes transparent
    ["-transparent"] = function(self, atoms, i)
        self.transparent = 1
        return 0
    end,
    -- hex-only color flags: each takes exactly one '#RRGGBB' / '#RGB' symbol.
    -- An invalid hex is skipped; the flag still consumes its one atom.
    ["-bgcolor"] = function(self, atoms, i)
        local c = hex_to_rgb(atoms[i])
        if c then
            self.bgcolor = c
            self.usetheme = 0
        end
        return 1
    end,
    ["-gridcolor"] = function(self, atoms, i)
        local c = hex_to_rgb(atoms[i])
        if c then
            self.gridcolor = c
            self.usetheme = 0
        end
        return 1
    end,
    ["-fgcolor"] = function(self, atoms, i)
        local c = hex_to_rgb(atoms[i])
        if c then
            self.fgcolor = c
            self.usetheme = 0
        end
        return 1
    end,
    ["-flashcolor"] = function(self, atoms, i)
        local c = hex_to_rgb(atoms[i])
        if c then
            self.flashcolor = c
            self.usetheme = 0
        end
        return 1
    end,
})

-- Strict validator for a color message from the inlet.
-- Accepts exactly one of:
--   * a single symbol atom beginning with '#'
--   * exactly three number atoms, each in [0, 255]
-- Anything else returns nil.
local function color_from_atoms(atoms)
    if #atoms == 1 and type(atoms[1]) == "string" then
        return hex_to_rgb(atoms[1])
    end
    if #atoms == 3
       and type(atoms[1]) == "number"
       and type(atoms[2]) == "number"
       and type(atoms[3]) == "number" then
        local r, g, b = atoms[1], atoms[2], atoms[3]
        if r >= 0 and r <= 255
           and g >= 0 and g <= 255
           and b >= 0 and b <= 255 then
            return { r, g, b }
        end
    end
    return nil
end

-- Reject any restored color that is not a {r, g, b} of numbers 0-255.
-- This cleans up older patches that saved a bare number, etc.
local function sanitize_color(c, default)
    default = default or { 0, 0, 0 }
    if type(c) == "table"
       and type(c[1]) == "number"
       and type(c[2]) == "number"
       and type(c[3]) == "number"
       and c[1] >= 0 and c[1] <= 255
       and c[2] >= 0 and c[2] <= 255
       and c[3] >= 0 and c[3] <= 255 then
        return { c[1], c[2], c[3] }
    end
    return default
end

function drum_seq:initialize(sel, atoms)
    self.inlets   = 1
    self.outlets  = 2
    self.cur_slot  = 0   -- the slot the cursor shows: the last one played
    self.next_slot = 1   -- the slot the next bang plays
    self.flashing   = false
    self.refresh_ms = 150
    self.clock = pd.Clock:new():register(self, "refresh")

    -- paint state
    self.paint_val        = nil
    self.last_painted_t   = nil
    self.last_painted_s   = nil

    self:init_args(atoms)

    -- drop any malformed color state inherited from older saves
    self.bgcolor    = sanitize_color(self.bgcolor,    { 255, 255, 255 })
    self.gridcolor  = sanitize_color(self.gridcolor,  { 0, 0, 0 })
    self.fgcolor    = sanitize_color(self.fgcolor,    { 128, 128, 159 })
    self.flashcolor = sanitize_color(self.flashcolor, { 200, 0, 0 })

    self:alloc_grid(self.tracks, self.slots)

    -- The saved grid is laid out by the slot count it was saved with, which
    -- an old patch may have above our limit: read it by that and crop it,
    -- rather than let each track run on into the next.
    if self.embed ~= 0 and #self.content > 0 then
        local stride = math.floor((self._unclamped or {}).slots or self.slots)
        for t = 1, self.tracks do
            for s = 1, self.slots do
                self.grid[t][s] = (self.content[(t - 1) * stride + s] or 0) ~= 0 and 1 or 0
            end
        end
    end

    self:set_size(self.slots * self.cell_size, self.tracks * self.cell_size)
    return true
end

function drum_seq:finalize()
    self.clock:destruct()
end

function drum_seq:in_1_list(atoms)
    local track  = math.floor(tonumber(atoms[1]) or 1)
    local slot   = math.floor(tonumber(atoms[2]) or 1)
    local status = (tonumber(atoms[3]) or 0) ~= 0 and 1 or 0
    if self:in_bounds(track, slot) then
        self.grid[track][slot] = status
        self:save_state(); self:repaint()
    end
end

-- track <n> <v0> <v1> ...: set all values for one track
function drum_seq:in_1_track(atoms)
    local track = math.floor(tonumber(atoms[1]) or 1)
    if track < 1 or track > self.tracks then return end
    for i = 2, #atoms do
        local slot = i - 1
        if slot <= self.slots then
            self.grid[track][slot] = (tonumber(atoms[i]) or 0) ~= 0 and 1 or 0
        end
    end
    self:save_state(); self:repaint()
end

-- import <list>: one track after another, separated by "||". The layout of
-- the message sets the number of tracks and slots.
function drum_seq:in_1_import(atoms)
    local rows, cur = {}, {}
    for _, a in ipairs(atoms) do
        if tostring(a) == "||" then
            rows[#rows + 1] = cur
            cur = {}
        else
            cur[#cur + 1] = (tonumber(a) or 0) ~= 0 and 1 or 0
        end
    end
    if #cur > 0 then rows[#rows + 1] = cur end
    if #rows == 0 then return end

    local slots = 0
    for _, r in ipairs(rows) do slots = math.max(slots, #r) end
    if slots == 0 then return end

    self.tracks = #rows
    self.slots  = slots
    self:resize_grid()
    for t, r in ipairs(rows) do
        for s = 1, self.slots do self.grid[t][s] = r[s] or 0 end
    end
    self:save_state(); self:repaint()
end

function drum_seq:save_state()
    if self.embed ~= 0 then
        self.content = {}
        for t = 1, self.tracks do
            for s = 1, self.slots do
                self.content[#self.content + 1] = self.grid[t][s]
            end
        end
    else
        self.content = {}
    end
    self:save_args()
end

function drum_seq:alloc_grid(t, s)
    self.grid = {}
    for tr = 1, t do
        self.grid[tr] = {}
        for sl = 1, s do self.grid[tr][sl] = 0 end
    end
end

-- A new number of tracks or slots starts again with an empty grid.
function drum_seq:resize_grid()
    self.cur_slot  = math.min(self.cur_slot, self.slots)
    self.next_slot = math.min(self.next_slot, self.slots)
    self:alloc_grid(self.tracks, self.slots)
    self:set_size(self.slots * self.cell_size, self.tracks * self.cell_size)
end

-- The properties dialog sets every field on OK, and a tracks or slots message
-- may repeat the size it already has: only a new size clears the grid.
function drum_seq:on_grid()
    if #self.grid == self.tracks and #self.grid[1] == self.slots then return end
    self:resize_grid()
    self:save_state(); self:repaint()
end

function drum_seq:on_resize()
    self:set_size(self.slots * self.cell_size, self.tracks * self.cell_size)
    self:repaint()
end

function drum_seq:in_bounds(t, s)
    return t >= 1 and t <= self.tracks and s >= 1 and s <= self.slots
end

function drum_seq:cell_at(x, y)
    local cs = self.cell_size
    local s  = math.max(1, math.min(self.slots,  math.floor(x / cs) + 1))
    local t  = math.max(1, math.min(self.tracks, math.floor(y / cs) + 1))
    return t, s
end

-- Output all track values at the current slot, one list per track.
function drum_seq:output_slot()
    for t = 1, self.tracks do
        self:outlet(1, "list", { t, self.grid[t][self.cur_slot] })
    end
end

-- Output a slot and make the one after it next. Playing the last slot is
-- the end of the sequence, reported with a bang right after its values.
-- The bang goes out the right outlet on its own, and out the left one
-- alongside the track values, which is where the older [drum.seq]
-- abstraction sent it. Drop the second outlet line below to keep only the
-- dedicated outlet.
function drum_seq:play(s)
    self.cur_slot  = s
    self.next_slot = s % self.slots + 1
    self:output_slot()
    if s == self.slots then
        self:outlet(2, "bang", {})
        self:outlet(1, "bang", {})
    end
    self.flashing = true
    self:repaint()
    self.clock:delay(self.refresh_ms)
end

function drum_seq:mouse_down(x, y)
    local t, s = self:cell_at(x, y)
    self.paint_val = 1 - self.grid[t][s]
    self.grid[t][s] = self.paint_val
    self.last_painted_t = t
    self.last_painted_s = s
    self:save_state(); self:repaint()
end

function drum_seq:mouse_drag(x, y)
    local t, s = self:cell_at(x, y)
    if t == self.last_painted_t and s == self.last_painted_s then return end
    self.grid[t][s] = self.paint_val
    self.last_painted_t = t
    self.last_painted_s = s
    self:save_state(); self:repaint()
end

-- bang: output the current slot's values, then move on to the next slot
function drum_seq:in_1_bang()
    self:play(self.next_slot)
end

-- float: output that slot, the next bang plays the one after it
function drum_seq:in_1_float(val)
    self:play(math.max(1, math.min(self.slots, math.floor(tonumber(val) or 1))))
end

-- goto: the next bang plays this slot; no output
function drum_seq:in_1_goto(atoms)
    local s = math.max(1, math.min(self.slots, math.floor(tonumber(atoms[1]) or 1)))
    self.cur_slot  = s
    self.next_slot = s
    self:repaint()
end

function drum_seq:in_1_clear()
    self:alloc_grid(self.tracks, self.slots)
    self:save_state(); self:repaint()
end

-- export <track>: one track as a list; with no argument every track, each
-- one followed by "||". Both go out with an "export" selector.
function drum_seq:in_1_export(atoms)
    local t = atoms[1] and math.floor(tonumber(atoms[1]) or 0)
    if t and t >= 1 and t <= self.tracks then
        local out = {}
        for s = 1, self.slots do out[s] = self.grid[t][s] end
        self:outlet(1, "export", out)
    else
        local out = {}
        for tr = 1, self.tracks do
            for s = 1, self.slots do out[#out + 1] = self.grid[tr][s] end
            out[#out + 1] = "||"
        end
        self:outlet(1, "export", out)
    end
end

function drum_seq:in_1_tracks(atoms)
    self.tracks = self:limited("tracks", math.floor(tonumber(atoms[1]) or self.tracks))
    self:on_grid()
end

function drum_seq:in_1_slots(atoms)
    self.slots = self:limited("slots", math.floor(tonumber(atoms[1]) or self.slots))
    self:on_grid()
end

function drum_seq:in_1_size(atoms)
    self.cell_size = self:limited("cell_size", math.floor(tonumber(atoms[1]) or self.cell_size))
    self:set_size(self.slots * self.cell_size, self.tracks * self.cell_size)
    self:save_state(); self:repaint()
end

function drum_seq:in_1_embed(atoms)
    self.embed = (tonumber(atoms[1]) or 0) ~= 0 and 1 or 0
    self:save_state()
end

function drum_seq:in_1_theme(atoms)
    self.usetheme = (tonumber(atoms[1]) or 0) ~= 0 and 1 or 0
    self:repaint()
    self:save_args()
end

-- Colors: only "#RRGGBB" / "#RGB" or exactly 3 numbers in [0, 255].
function drum_seq:in_1_bgcolor(atoms)
    local c = color_from_atoms(atoms)
    if not c then return end
    self.bgcolor = c
    self.usetheme = 0   -- an explicit color means: use this color
    self:save_args(); self:repaint()
end

function drum_seq:in_1_gridcolor(atoms)
    local c = color_from_atoms(atoms)
    if not c then return end
    self.gridcolor = c
    self.usetheme = 0   -- an explicit color means: use this color
    self:save_args(); self:repaint()
end

function drum_seq:in_1_fgcolor(atoms)
    local c = color_from_atoms(atoms)
    if not c then return end
    self.fgcolor = c
    self.usetheme = 0   -- an explicit color means: use this color
    self:save_args(); self:repaint()
end

function drum_seq:in_1_flashcolor(atoms)
    local c = color_from_atoms(atoms)
    if not c then return end
    self.flashcolor = c
    self.usetheme = 0   -- an explicit color means: use this color
    self:save_args(); self:repaint()
end

-- All four colors in one shot:
--   colors #RRGGBB #RRGGBB #RRGGBB #RRGGBB
-- bgcolor, gridcolor, fgcolor, flashcolor — in that order.
-- Only four hex symbols are accepted; anything else is ignored.
function drum_seq:in_1_colors(atoms)
    if #atoms ~= 4 then return end
    local c = {}
    for i = 1, 4 do
        if type(atoms[i]) ~= "string" then return end
        c[i] = hex_to_rgb(atoms[i])
        if not c[i] then return end
    end
    self.bgcolor    = c[1]
    self.gridcolor  = c[2]
    self.fgcolor    = c[3]
    self.flashcolor = c[4]
    self.usetheme   = 0   -- an explicit color means: use this color
    self:save_args(); self:repaint()
end

function drum_seq:refresh()
    self.flashing = false
    self:repaint()
end

function drum_seq:paint(g)
    local cs   = self.cell_size
    local w, h = self:get_size()
    local bg   = self:background("bgcolor")
    local gc   = self:color("gridcolor")
    local ac   = self:color("fgcolor")
    local fc   = self:color("flashcolor")

    -- background
    if bg then
        g:set_color(bg[1], bg[2], bg[3])
        g:fill_rect(0, 0, w, h)
    end

    -- cursor column: the lines around and across it in the active/foreground colour,
    -- its cells in the cursor colour
    local cur    = math.max(1, self.cur_slot)
    local cx     = (cur - 1) * cs
    local x1, x2 = math.max(0, cx - 1), math.min(w, cx + cs + 1)

    -- active/foreground cells
    g:set_color(ac[1], ac[2], ac[3])
    for t = 1, self.tracks do
        for s = 1, self.slots do
            if self.grid[t][s] ~= 0 then
                g:fill_rect((s - 1) * cs, (t - 1) * cs, cs, cs)
            end
        end
    end

    -- grid lines
    g:set_color(gc[1], gc[2], gc[3])
    for s = 1, self.slots - 1 do g:fill_rect(s * cs - 1, 0, 2, h) end
    for t = 1, self.tracks - 1 do g:fill_rect(0, t * cs - 1, w, 2) end

    -- outline
    g:set_color(0, 0, 0, 0)
    g:fill_all()

    local col = self.flashing and fc or gc
    g:set_color(col[1], col[2], col[3])
    for t = 1, self.tracks do
        g:stroke_rect(cx, (t - 1) * cs, cs, cs, 3)
    end
end
