local else_gui = require("else_gui")
local incdec   = pd.Class:new():register("incdec")

else_gui.setup(incdec, {
    { "width",     20,           "on_resize", "Width",      "int",   {frame="Dimensions", min=20, max=4096, flag="width"} },
    { "height",    30,           "on_resize", "Height",     "int",   {frame="Dimensions", min=12, max=4096, flag="height"} },
    { "step",      1,            nil,         "Step",       "float", {frame="General", flag="step"} },
    { "range",     {-1e6, 1e6},  "on_range",  "Range",      "range", {frame="General", flag="range"} },
    { "savestate", 0,            "save_state", "Save State", "check", {frame="General", flag="savestate"} },
    { "init_val",  0,            nil,         nil,          "float" },
    { "bgcolor",   pd.bg_color,  "repaint",   "Background", "color", {frame="Appearance", flag="bgcolor"} },
    { "fgcolor",   pd.fg_color,  "repaint",   "Foreground", "color", {frame="Appearance", flag="fgcolor"} },
    { "send",      "empty",      nil,         "Send",       "text",  {frame="General", flag="send", dollar=true} },
    { "receive",   "empty",      "on_receive","Receive",    "text",  {frame="General", flag="receive", dollar=true} },
    -- appended so that the positional argument order above never changes
    { "autorepeat", 0,           nil,         "Autorepeat", "check", {frame="General", flag="repeat", msg="repeat"} },
    { "relative",  0,            nil,         "Relative",   "check", {frame="General", flag="relative"} },
    { "horizontal",0,            "on_resize", "Horizontal", "check", {frame="General", flag="horizontal"} },
})

local REPEAT_DELAY = 400   -- ms held down before autorepeat kicks in
local REPEAT_RATE  = 60    -- ms between repeats after that

function incdec:initialize(sel, atoms)
    self.inlets  = 1
    self.outlets = 1
    self.shift   = false
    self.active  = 0   -- -1 = down pressed, 1 = up pressed, 0 = idle

    self:init_args(atoms)

    self.val = (self.savestate ~= 0) and self.init_val or 0

    self.clock = pd.Clock:new():register(self, "repeat_tick")

    self:setup_receive(self.receive)
    self:set_size(self.width, self.height)
    return true
end

function incdec:finalize()
    self.clock:destruct()
end

function incdec:on_resize()
    self:set_size(self.width, self.height)
end

function incdec:on_receive(sym)
    self:setup_receive(sym)
end

-- a new range from the properties: keep the value inside it
function incdec:on_range()
    self.val = self:clamp(self.val)
    self:save_state()
end

function incdec:clamp(v)
    local lo = math.min(self.range[1], self.range[2])
    local hi = math.max(self.range[1], self.range[2])
    return math.max(lo, math.min(hi, v))
end

function incdec:current_step()
    return self.shift and self.step / 10 or self.step
end

function incdec:increment()
    if self.relative ~= 0 then
        self.val = 1
    else
        self.val = self:clamp(self.val + self:current_step())
    end
    self:save_state(); self:repaint(); self:output()
end

function incdec:decrement()
    if self.relative ~= 0 then
        self.val = -1
    else
        self.val = self:clamp(self.val - self:current_step())
    end
    self:save_state(); self:repaint(); self:output()
end

-- autorepeat: keep stepping while the button is held
function incdec:repeat_tick()
    if self.active == 1 then
        self:increment()
    elseif self.active == -1 then
        self:decrement()
    else
        return
    end
    self.clock:delay(REPEAT_RATE)
end

-- While we output, what comes back in through the receive name is dropped,
-- and an answer to [retrieve] isn't sent (see receive_cb in else_gui).
function incdec:output()
    local outer = self._outputting
    self._outputting = true
    self:outlet(1, "float", { self.val })
    if self.send ~= "empty" and self.send ~= "" and not self._retrieving then
        pd.send(self:realize_symbol(self.send), "float", { self.val })
    end
    self._outputting = outer   -- outputs can nest, so restore
end

local _base_save_args = incdec.save_args

-- In save state mode the saved value is the current one. It is taken here,
-- on every save, so that a save for any reason (a range that clamps the
-- value, a property) keeps it up to date.
function incdec:save_args()
    if self.savestate ~= 0 and self.val then self.init_val = self.val end
    _base_save_args(self)
end

-- a new value only changes the arguments in save state mode
function incdec:save_state()
    if self.savestate ~= 0 then self:save_args() end
end

function incdec:in_1_bang()
    self:output()
end

-- a list of one number, as [presets] or [list] send it, is that number
function incdec:in_1_list(atoms)
    if tonumber(atoms[1]) then self:in_1_float(atoms[1]) end
end

function incdec:in_1_float(atoms)
    self.val = self:clamp(else_gui.as_float(atoms) or 0)
    self:save_state(); self:repaint(); self:output()
end

function incdec:in_1_set(atoms)
    self.val = self:clamp(tonumber(atoms[1]) or 0)
    self:save_state(); self:repaint()
end

function incdec:in_1_step(atoms)
    self.step = tonumber(atoms[1]) or self.step
    self:save_args()
end

function incdec:in_1_range(atoms)
    self.range = {
        tonumber(atoms[1]) or self.range[1],
        tonumber(atoms[2]) or self.range[2],
    }
    self.val = self:clamp(self.val)
    self:save_args(); self:repaint()
end

function incdec:mouse_down(x, y)
    local w, h = self:get_size()
    local up
    if self.horizontal ~= 0 then
        up = x >= w / 2          -- right half increments
    else
        up = y < h / 2           -- top half increments
    end
    if up then
        self.active = 1
        self:increment()
    else
        self.active = -1
        self:decrement()
    end
    if self.autorepeat ~= 0 then self.clock:delay(REPEAT_DELAY) end
end

function incdec:mouse_up()
    self.active = 0
    self.clock:unset()
    self:repaint()
end

function incdec:key(down, name)
    if name == "Shift_L" or name == "Shift_R" then
        self.shift = (down ~= 0)
    end
end

function incdec:paint(g)
    local w, h = self:get_size()

    -- background
    g:set_color(self.bgcolor[1], self.bgcolor[2], self.bgcolor[3])
    g:fill_all()

    local lw = math.max(1.5, math.min(2.5, math.min(w, h) / 20))
    local up_color = (self.active ==  1) and self.bgcolor or self.fgcolor
    local dn_color = (self.active == -1) and self.bgcolor or self.fgcolor

    if self.horizontal ~= 0 then
        local mid = w / 2

        -- highlight the half being pressed: right increments, left decrements
        g:set_color(self.fgcolor[1], self.fgcolor[2], self.fgcolor[3])
        if self.active == 1 then
            g:fill_rect(mid, 0, mid, h)
        elseif self.active == -1 then
            g:fill_rect(0, 0, mid, h)
        end

        -- divider
        g:draw_line(mid, 0, mid, h, 1)

        local my = h * 0.25
        local mx = mid * 0.25

        -- left arrow < (decrement)
        g:set_color(dn_color[1], dn_color[2], dn_color[3])
        local lt = Path(mid - mx, my)
        lt:line_to(mx, h / 2)
        lt:line_to(mid - mx, h - my)
        g:stroke_path(lt, lw)

        -- right arrow > (increment)
        g:set_color(up_color[1], up_color[2], up_color[3])
        local rt = Path(mid + mx, my)
        rt:line_to(w - mx, h / 2)
        rt:line_to(mid + mx, h - my)
        g:stroke_path(rt, lw)
    else
        local mid = h / 2

        -- highlight the half being pressed: top increments, bottom decrements
        g:set_color(self.fgcolor[1], self.fgcolor[2], self.fgcolor[3])
        if self.active == 1 then
            g:fill_rect(0, 0, w, mid)
        elseif self.active == -1 then
            g:fill_rect(0, mid, w, mid)
        end

        -- divider
        g:draw_line(0, mid, w, mid, 1)

        local mx = w * 0.25
        local my = mid * 0.25

        -- up arrow (increment)
        g:set_color(up_color[1], up_color[2], up_color[3])
        local up = Path(mx, mid - my)
        up:line_to(w / 2, my)
        up:line_to(w - mx, mid - my)
        g:stroke_path(up, lw)

        -- down arrow (decrement)
        g:set_color(dn_color[1], dn_color[2], dn_color[3])
        local dn = Path(mx, mid + my)
        dn:line_to(w / 2, h - my)
        dn:line_to(w - mx, mid + my)
        g:stroke_path(dn, lw)
    end

    -- plugdata dynamic resize
    if w ~= self.width or h ~= self.height then
        self.width = w
        self.height = h
        self:save_args()
    end
end
