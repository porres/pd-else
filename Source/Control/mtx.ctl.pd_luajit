local else_gui = require("else_gui")
local mtxctl   = pd.Class:new():register("mtx.ctl")

-- Parse "#RRGGBB" or "#RGB" (leading # REQUIRED); returns {r,g,b} or nil.
-- Defined before else_gui.setup so the color-flag handlers can use it.
local function hex_to_rgb(hex)
    if type(hex) ~= "string" then return nil end
    if hex:sub(1, 1) ~= "#" then return nil end
    hex = hex:sub(2)
    if #hex == 3 then hex = hex:gsub("(.)", "%1%1") end
    if #hex ~= 6 then return nil end
    local r = tonumber(hex:sub(1, 2), 16)
    local g = tonumber(hex:sub(3, 4), 16)
    local b = tonumber(hex:sub(5, 6), 16)
    if not (r and g and b) then return nil end
    return { r, g, b }
end

else_gui.setup(mtxctl, {
    { "cols",      3,             "on_cols",      "Columns",    "int",   {frame="Dimensions", min=1, max=256, flag="cols"} },
    { "rows",      3,             "on_rows",      "Rows",       "int",   {frame="Dimensions", min=1, max=256, flag="rows"} },
    { "cell_size", 20,            "on_cell_size", "Cell Size",  "int",   {frame="Dimensions", min=4, max=128, flag="size"} },
    { "embed",     0,             "save_state",   "Embed",      "check", {frame="Dimensions", flag="embed"} },
    -- 11 dummy positional placeholders to match the original arg layout
    { "_d1", 0 }, { "_d2", 0 }, { "_d3", 0 }, { "_d4", 0 }, { "_d5", 0 },
    { "_d6", 0 }, { "_d7", 0 }, { "_d8", 0 }, { "_d9", 0 }, { "_d10", 0 }, { "_d11", 0 },
    { "content",   {},            nil,            nil,          "float", {consume="rows*cols"} },
    { "bgcolor",   {255,255,255}, "repaint",      "Background", "color", {frame="Appearance", flag="bgcolor", theme="bg"} },
    { "gridcolor", {0,0,0},       "repaint",      "Grid",       "color", {frame="Appearance", flag="gridcolor", theme="fg"} },
    { "fgcolor",   {128,128,159}, "repaint",      "Foreground","color", {frame="Appearance", flag="fgcolor", theme="sel"} },
    -- appended so that the positional argument order above never changes
    { "usetheme",    0, "repaint", "Use Theme Colors", "check", {frame="Appearance", order=0, flag="usetheme"} },
    { "transparent", 0, "repaint", "Transparent",      "check", {frame="Appearance", order=0, flag="transparent"} },
}, {
    ["-embed"] = function(self, atoms, i)
        self.embed = 1
        return 0
    end,
    ["-theme"] = function(self, atoms, i)
        self.usetheme = 1
        return 0
    end,
    -- -n <cols> <rows>: both counts at once, clamped to the property limits
    ["-n"] = function(self, atoms, i)
        self.cols = math.max(1, math.min(256, math.floor(tonumber(atoms[i])   or self.cols)))
        self.rows = math.max(1, math.min(256, math.floor(tonumber(atoms[i+1]) or self.rows)))
        return 2
    end,
    -- -size <f>: cell size in pixels, clamped to 4-128
    ["-size"] = function(self, atoms, i)
        local v = else_gui.numbers(atoms, i, 1)
        if v[1] then
            self.cell_size = math.max(4, math.min(128, math.floor(v[1])))
        end
        return #v
    end,
    -- bare flag: background becomes transparent
    ["-transparent"] = function(self, atoms, i)
        self.transparent = 1
        return 0
    end,
    -- hex-only color flags: each takes exactly one '#RRGGBB' / '#RGB' symbol.
    -- An invalid hex is skipped; the flag still consumes its one atom.
    ["-bgcolor"] = function(self, atoms, i)
        local c = hex_to_rgb(atoms[i])
        if c then
            self.bgcolor = c
            self.usetheme = 0
        end
        return 1
    end,
    ["-gridcolor"] = function(self, atoms, i)
        local c = hex_to_rgb(atoms[i])
        if c then
            self.gridcolor = c
            self.usetheme = 0
        end
        return 1
    end,
    ["-fgcolor"] = function(self, atoms, i)
        local c = hex_to_rgb(atoms[i])
        if c then
            self.fgcolor = c
            self.usetheme = 0
        end
        return 1
    end,
})

-- Strict validator for a color message from the inlet.
-- Accepts exactly one of:
--   * a single symbol atom beginning with '#'
--   * exactly three number atoms, each in [0, 255]
-- Anything else returns nil.
local function color_from_atoms(atoms)
    if #atoms == 1 and type(atoms[1]) == "string" then
        return hex_to_rgb(atoms[1])
    end
    if #atoms == 3
       and type(atoms[1]) == "number"
       and type(atoms[2]) == "number"
       and type(atoms[3]) == "number" then
        local r, g, b = atoms[1], atoms[2], atoms[3]
        if r >= 0 and r <= 255
           and g >= 0 and g <= 255
           and b >= 0 and b <= 255 then
            return { r, g, b }
        end
    end
    return nil
end

-- Reject any restored color that is not a {r, g, b} of numbers 0-255.
-- This cleans up older patches that saved a bare number, etc.
local function sanitize_color(c, default)
    default = default or { 0, 0, 0 }
    if type(c) == "table"
       and type(c[1]) == "number"
       and type(c[2]) == "number"
       and type(c[3]) == "number"
       and c[1] >= 0 and c[1] <= 255
       and c[2] >= 0 and c[2] <= 255
       and c[3] >= 0 and c[3] <= 255 then
        return { c[1], c[2], c[3] }
    end
    return default
end

function mtxctl:initialize(sel, atoms)
    self.inlets  = 1
    self.outlets = 1
    self.paint_val      = nil
    self.last_painted_r = nil
    self.last_painted_c = nil

    self:init_args(atoms)

    -- drop any malformed color state inherited from older saves
    self.bgcolor   = sanitize_color(self.bgcolor,   { 255, 255, 255 })
    self.gridcolor = sanitize_color(self.gridcolor, { 0, 0, 0 })
    self.fgcolor   = sanitize_color(self.fgcolor,   { 128, 128, 159 })

    self:resize_matrix(self.rows, self.cols)

    -- init_args has already read the embedded cells into self.content. They
    -- are laid out by the column count they were saved with, which an old
    -- patch may have above our limit: read them by that and crop them.
    if self.embed ~= 0 and #self.content > 0 then
        local stride = math.floor((self._unclamped or {}).cols or self.cols)
        for r = 1, self.rows do
            for c = 1, self.cols do
                self.matrix[r][c] = (self.content[(r - 1) * stride + c] or 0) ~= 0 and 1 or 0
            end
        end
    end

    self:update_size()
    return true
end

-- Columns and rows count from 0 on the way in, the same as the outlet
-- reports them; the matrix itself is a 1-based Lua table.
function mtxctl:in_1_list(atoms)
    local c   = math.floor(tonumber(atoms[1]) or 0) + 1
    local r   = math.floor(tonumber(atoms[2]) or 0) + 1
    local val = (tonumber(atoms[3]) or 0) ~= 0 and 1 or 0
    if not self:in_bounds(r, c) then return end
    self.matrix[r][c] = val
    self:output_cell(r, c)
    self:save_state(); self:repaint()
end

function mtxctl:in_1_set(atoms)
    local c   = math.floor(tonumber(atoms[1]) or 0) + 1
    local r   = math.floor(tonumber(atoms[2]) or 0) + 1
    local val = (tonumber(atoms[3]) or 0) ~= 0 and 1 or 0
    if not self:in_bounds(r, c) then return end
    self.matrix[r][c] = val
    self:save_state(); self:repaint()
end

function mtxctl:in_1_get(atoms)
    local c = math.floor(tonumber(atoms[1]) or 0) + 1
    local r = math.floor(tonumber(atoms[2]) or 0) + 1
    if not self:in_bounds(r, c) then return end
    self:output_cell(r, c)
end

function mtxctl:in_1_rows(atoms)
    local n = self:limited("rows", math.floor(tonumber(atoms[1]) or self.rows))
    self:resize_matrix(n, self.cols)
    self:update_size(); self:save_state(); self:repaint()
end

function mtxctl:in_1_columns(atoms)
    local n = self:limited("cols", math.floor(tonumber(atoms[1]) or self.cols))
    self:resize_matrix(self.rows, n)
    self:update_size(); self:save_state(); self:repaint()
end

function mtxctl:in_1_size(atoms)
    self.cell_size = self:limited("cell_size", math.floor(tonumber(atoms[1]) or self.cell_size))
    self:update_size(); self:save_state(); self:repaint()
end

function mtxctl:in_1_embed(atoms)
    self.embed = (tonumber(atoms[1]) or 0) ~= 0 and 1 or 0
    self:save_state()
end

function mtxctl:in_1_theme(atoms)
    self.usetheme = (tonumber(atoms[1]) or 0) ~= 0 and 1 or 0
    self:repaint()
    self:save_args()
end

-- Colors: only "#RRGGBB" / "#RGB" or exactly 3 numbers in [0, 255].
function mtxctl:in_1_bgcolor(atoms)
    local c = color_from_atoms(atoms)
    if not c then return end
    self.bgcolor = c
    self.usetheme = 0   -- an explicit color means: use this color
    self:save_args(); self:repaint()
end

function mtxctl:in_1_gridcolor(atoms)
    local c = color_from_atoms(atoms)
    if not c then return end
    self.gridcolor = c
    self.usetheme = 0   -- an explicit color means: use this color
    self:save_args(); self:repaint()
end

function mtxctl:in_1_fgcolor(atoms)
    local c = color_from_atoms(atoms)
    if not c then return end
    self.fgcolor = c
    self.usetheme = 0   -- an explicit color means: use this color
    self:save_args(); self:repaint()
end

-- All three colors in one shot:
--   colors #RRGGBB #RRGGBB #RRGGBB
-- bgcolor, gridcolor, fgcolor — in that order.
-- Only three hex symbols are accepted; anything else is ignored.
function mtxctl:in_1_colors(atoms)
    if #atoms ~= 3 then return end
    local c = {}
    for i = 1, 3 do
        if type(atoms[i]) ~= "string" then return end
        c[i] = hex_to_rgb(atoms[i])
        if not c[i] then return end
    end
    self.bgcolor   = c[1]
    self.gridcolor = c[2]
    self.fgcolor   = c[3]
    self.usetheme  = 0   -- an explicit color means: use this color
    self:save_args(); self:repaint()
end

function mtxctl:in_1_import(atoms)
    local n = 1
    for r = 1, self.rows do
        for c = 1, self.cols do
            self.matrix[r][c] = (tonumber(atoms[n]) or 0) ~= 0 and 1 or 0
            n = n + 1
        end
    end
    self:save_state(); self:repaint()
end

function mtxctl:save_state()
    if self.embed ~= 0 then
        self.content = {}
        for r = 1, self.rows do
            for c = 1, self.cols do
                self.content[#self.content + 1] = self.matrix[r][c]
            end
        end
    else
        self.content = {}
    end
    self:save_args()
end

function mtxctl:on_rows()
    self:resize_matrix(self.rows, self.cols)
    self:update_size(); self:save_state(); self:repaint()
end

function mtxctl:on_cols()
    self:resize_matrix(self.rows, self.cols)
    self:update_size(); self:save_state(); self:repaint()
end

function mtxctl:on_cell_size()
    self:update_size(); self:repaint()
end

function mtxctl:update_size()
    self:set_size(self.cols * self.cell_size, self.rows * self.cell_size)
end

function mtxctl:in_bounds(r, c)
    return r >= 1 and r <= self.rows and c >= 1 and c <= self.cols
end

function mtxctl:cell_at(x, y)
    local c = math.max(1, math.min(self.cols, math.floor(x / self.cell_size) + 1))
    local r = math.max(1, math.min(self.rows, math.floor(y / self.cell_size) + 1))
    return r, c
end

function mtxctl:output_cell(r, c)
    self:outlet(1, "list", { c-1, r-1, self.matrix[r][c] })
end

-- keeps every cell that is still inside the new size
function mtxctl:resize_matrix(new_rows, new_cols)
    local old = self.matrix or {}
    self.rows = new_rows
    self.cols = new_cols

    self.matrix = {}
    for r = 1, self.rows do
        self.matrix[r] = {}
        for c = 1, self.cols do self.matrix[r][c] = old[r] and old[r][c] or 0 end
    end
end

function mtxctl:mouse_down(x, y)
    local r, c = self:cell_at(x, y)
    self.paint_val = 1 - self.matrix[r][c]
    self.matrix[r][c] = self.paint_val
    self.last_painted_r, self.last_painted_c = r, c
    self:output_cell(r, c)
    self:save_state(); self:repaint()
end

function mtxctl:mouse_drag(x, y)
    local r, c = self:cell_at(x, y)
    if r == self.last_painted_r and c == self.last_painted_c then return end
    self.matrix[r][c] = self.paint_val
    self.last_painted_r, self.last_painted_c = r, c
    self:output_cell(r, c)
    self:save_state(); self:repaint()
end

function mtxctl:in_1_bang()
    self:in_1_flush()
end

function mtxctl:in_1_clear()
    for r = 1, self.rows do
        for c = 1, self.cols do self.matrix[r][c] = 0 end
    end
    self:save_state(); self:repaint()
end

function mtxctl:in_1_flush()
    for r = 1, self.rows do
        for c = 1, self.cols do self:output_cell(r, c) end
    end
end

-- the dump goes out with an "export" selector so it can be told apart from
-- ordinary cell output with [route export]
function mtxctl:in_1_export()
    local out = {}
    for r = 1, self.rows do
        for c = 1, self.cols do out[#out + 1] = self.matrix[r][c] end
    end
    self:outlet(1, "export", out)
end

function mtxctl:paint(g)
    local w, h  = self:get_size()
    local cs    = self.cell_size
    local fg    = self:color("fgcolor")
    local grid  = self:color("gridcolor")

    self:fill_background(g, "bgcolor")

    g:set_color(fg[1], fg[2], fg[3])
    for r = 1, self.rows do
        for c = 1, self.cols do
            if self.matrix[r][c] ~= 0 then
                g:fill_rect((c-1)*cs, (r-1)*cs, cs, cs)
            end
        end
    end

    g:set_color(grid[1], grid[2], grid[3])
    for c = 1, self.cols-1 do g:draw_line(c*cs, 0, c*cs, h, 1) end
    for r = 1, self.rows-1 do g:draw_line(0, r*cs, w, r*cs, 1) end

    -- outline: drawn last, as in drum.seq, so the cells don't cover it
    g:set_color(0, 0, 0, 0)
    g:fill_all()
end
