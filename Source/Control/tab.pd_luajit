local else_gui = require("else_gui")
local tab      = pd.Class:new():register("tab")

local CHAR_W   = 7    -- approximate character width in default font
local FONT     = 11
local PAD_X    = 6    -- horizontal padding per tab

else_gui.setup(tab, {
    { "width",       200,           "on_resize", "Width",      "int",   {frame="Dimensions", min=30, max=4096, flag="width"} },
    { "height",      25,            "on_resize", "Height",     "int",   {frame="Dimensions", min=12, max=256,  flag="height"} },
    { "ntabs",       3,             "on_ntabs",  "Tabs",       "int",   {frame="General",    min=1,  max=128,  flag="ntabs"} },
    { "savestate",   0,             "save_state", "Save State", "check", {frame="General", flag="savestate"} },
    { "init_tab",    0,             nil,         nil,          "int" },
    { "bgcolor",     pd.bg_color,   "repaint",   "Background", "color", {frame="Appearance", flag="bgcolor"} },
    { "activecolor", pd.fg_color,   "repaint",   "Active Tab", "color", {frame="Appearance", flag="activecolor"} },
    { "fgcolor",     pd.fg_color,   "repaint",   "Text",       "color", {frame="Appearance", flag="fgcolor"} },
    { "activetextcolor", pd.bg_color, "repaint", "Active Text","color", {frame="Appearance", flag="activetextcolor"} },
    { "send",        "empty",       nil,         "Send",       "text",  {frame="General", flag="send", dollar=true} },
    { "receive",     "empty",       "on_receive","Receive",    "text",  {frame="General", flag="receive", dollar=true} },
    -- appended so that the positional argument order above never changes
    { "mode",        0,             nil,         "Output Label","check", {frame="General", flag="mode"} },
}, {
    -- -labels tab1 tab2 tab3 ...  (takes words up to the next of our flags,
    -- so a label may start with "-", like "-3dB")
    ["-labels"] = function(self, atoms, i)
        self._flag_labels = {}
        local n = 0
        while i + n <= #atoms and not self:is_flag(atoms[i + n]) do
            self._flag_labels[#self._flag_labels + 1] = else_gui.text(atoms[i + n])
            n = n + 1
        end
        return n
    end,
})

-- the labels are saved after the declared arguments
function tab:extra_args(out)
    out[#out + 1] = "-labels"
    for i = 1, self.ntabs do
        out[#out + 1] = self.labels[i] or ("tab" .. i)
    end
end

function tab:initialize(sel, atoms)
    self.inlets  = 1
    self.outlets = 1
    self.labels  = {}

    self:init_args(atoms)

    -- a creation argument of 0 or less would divide by zero when painting
    self.ntabs = math.max(1, math.floor(tonumber(self.ntabs) or 1))

    -- default labels (no spaces — Pd atoms can't contain whitespace)
    for i = 1, self.ntabs do
        self.labels[i] = self.labels[i] or ("tab" .. i)
    end

    -- apply -labels flag if captured during init_args
    if self._flag_labels then
        for i, lbl in ipairs(self._flag_labels) do
            if i <= self.ntabs then self.labels[i] = lbl end
        end
        self._flag_labels = nil
    end

    self.active = (self.savestate ~= 0) and self.init_tab or 0
    self.active = math.max(0, math.min(self.ntabs - 1, self.active))

    self:setup_receive(self.receive)
    self:set_size(self.width, self.height)
    return true
end

function tab:on_resize()
    self:set_size(self.width, self.height)
end

function tab:on_ntabs()
    self.ntabs = math.max(1, self.ntabs)
    local old = self.labels
    self.labels = {}
    for i = 1, self.ntabs do
        self.labels[i] = old[i] or ("tab" .. i)
    end
    self.active = math.max(0, math.min(self.ntabs - 1, self.active))
    self:save_args(); self:repaint()
end

function tab:on_receive(sym)
    self:setup_receive(sym)
end

function tab:select_tab(idx)
    self.active = math.max(0, math.min(self.ntabs - 1, math.floor(idx)))
    self:save_state(); self:repaint()
end

-- While we output, what comes back in through the receive name is dropped,
-- and an answer to [retrieve] isn't sent (see receive_cb in else_gui).
function tab:output()
    local outer = self._outputting
    self._outputting = true
    local sel, val
    if self.mode ~= 0 then
        sel, val = "symbol", self.labels[self.active + 1] or ""
    else
        sel, val = "float", self.active
    end
    self:outlet(1, sel, { val })
    if self.send ~= "empty" and self.send ~= "" and not self._retrieving then
        pd.send(self:realize_symbol(self.send), sel, { val })
    end
    self._outputting = outer   -- outputs can nest, so restore
end

function tab:save_state()
    if self.savestate ~= 0 then
        self.init_tab = self.active
        self:save_args()
    end
end

function tab:in_1_bang()
    self:output()
end

-- a list of one number, as [presets] or [list] send it, is that number
function tab:in_1_list(atoms)
    if tonumber(atoms[1]) then self:in_1_float(atoms[1]) end
end

function tab:in_1_float(atoms)
    self:select_tab(else_gui.as_float(atoms) or 0)
    self:output()
end

-- set <index or label>: select a tab without output
function tab:in_1_set(atoms)
    local a = atoms[1]
    local idx = (a == nil) and 0 or tonumber(a) or self:label_index(else_gui.text(a))
    if idx then self:select_tab(idx) end
end

-- a label selects its tab and outputs, as its index does; it's what a tab in
-- label mode outputs, so what [presets] sends back to it
function tab:in_1_symbol(s)
    local idx = self:label_index(else_gui.text(s))
    if idx then self:select_tab(idx); self:output() end
end

-- the index of the tab with this label, counting from 0, or nil
function tab:label_index(s)
    for i = 1, self.ntabs do
        if self.labels[i] == s then return i - 1 end
    end
end

-- labels <s1> <s2> ...: set all tab labels
function tab:in_1_labels(atoms)
    for i = 1, math.min(#atoms, self.ntabs) do
        self.labels[i] = else_gui.text(atoms[i])
    end
    self:save_args(); self:repaint()
end

-- label <idx> <text>: set a single tab label (0-indexed)
function tab:in_1_label(atoms)
    local idx = math.floor(tonumber(atoms[1]) or 0) + 1
    if idx >= 1 and idx <= self.ntabs and atoms[2] then
        self.labels[idx] = else_gui.text(atoms[2])
        self:save_args(); self:repaint()
    end
end

-- tabs <n>: change the number of tabs
function tab:in_1_tabs(atoms)
    local n = tonumber(atoms[1])
    if n then
        self.ntabs = self:limited("ntabs", math.floor(n))
        self:on_ntabs()
    end
end

-- The left edge of tab i (counting from 0) in a box w wide. Painting and
-- clicking both go by it, so the click areas are the tabs you see.
function tab:tab_edge(i, w)
    return math.floor(i * w / math.max(1, self.ntabs) + 0.5)
end

function tab:mouse_down(x, y)
    local w = select(1, self:get_size())
    local idx = self.ntabs - 1
    for i = 1, self.ntabs - 1 do
        if x < self:tab_edge(i, w) then idx = i - 1; break end
    end
    self:select_tab(idx)
    self:output()
end

function tab:paint(g)
    local w, h = self:get_size()
    local n  = math.max(1, self.ntabs)     -- never divide by zero here

    -- background
    g:set_color(self.bgcolor[1], self.bgcolor[2], self.bgcolor[3])
    g:fill_all()

    -- active tab fill
    local a0, a1 = self:tab_edge(self.active, w), self:tab_edge(self.active + 1, w)
    g:set_color(self.activecolor[1], self.activecolor[2], self.activecolor[3])
    g:fill_rect(a0, 0, a1 - a0, h)

    -- dividers
    g:set_color(self.fgcolor[1], self.fgcolor[2], self.fgcolor[3])
    for i = 1, n - 1 do
        local x = self:tab_edge(i, w)
        g:draw_line(x, 0, x, h, 1)
    end

    -- labels
    local text_y = (h - FONT) / 2
    for i = 1, n do
        local lbl = self.labels[i] or ""
        local is_active = (i - 1) == self.active

        if is_active then
            g:set_color(self.activetextcolor[1], self.activetextcolor[2], self.activetextcolor[3])
        else
            g:set_color(self.fgcolor[1], self.fgcolor[2], self.fgcolor[3])
        end

        -- center text in tab cell
        local x0, x1 = self:tab_edge(i - 1, w), self:tab_edge(i, w)
        local text_w = #lbl * CHAR_W
        local tx = x0 + (x1 - x0 - text_w) / 2
        g:draw_text(lbl, tx, text_y, x1 - x0, FONT)
    end

    -- plugdata dynamic resize
    if w ~= self.width or h ~= self.height then
        self.width = w
        self.height = h
        self:save_args()
    end
end
