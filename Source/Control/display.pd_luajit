package.path = package.path .. ";" .. (pd._loadpath or ".") .. "/luadeps/?.lua"
local else_gui = require("else_gui")
local display = pd.Class:new():register("display")

-- [display] shows every message it receives, so it must not answer to any
-- message itself: the settings below are creation flags and properties only.

-- Width per character at the reference font size (Pd's default, 12).
-- The box is scaled from these when a custom font size is set.
local CHAR_W        = 7
local REF_FONT_SIZE = 12
local REF_HEIGHT    = 19

local function char_w(fs)
    if fs <= 0 then return CHAR_W end
    return math.max(1, math.floor(CHAR_W * fs / REF_FONT_SIZE + 0.5))
end

local function box_h(fs)
    if fs <= 0 then return REF_HEIGHT end
    return math.max(1, math.floor(REF_HEIGHT * fs / REF_FONT_SIZE + 0.5))
end

-- Text is UTF-8, so count and cut it by characters, not bytes: a character
-- starts at every byte that isn't a continuation byte (128-191).
local function ulen(s)
    return select(2, s:gsub("[^\128-\191]", ""))
end

-- the first n characters of s
local function usub(s, n)
    local count = 0
    for i = 1, #s do
        local c = s:byte(i)
        if c < 128 or c >= 192 then
            if count == n then return s:sub(1, i - 1) end
            count = count + 1
        end
    end
    return s
end

-- Parse a hex color string that MUST start with '#'.
-- Accepts "#RRGGBB" or "#RGB"; returns {r, g, b}, or nil if invalid.
local function hex_to_rgb(hex)
    if type(hex) ~= "string" then return nil end
    if hex:sub(1, 1) ~= "#" then return nil end
    hex = hex:sub(2)
    if #hex == 3 then
        hex = hex:gsub("(.)", "%1%1")
    end
    if #hex ~= 6 then return nil end
    local r = tonumber(hex:sub(1, 2), 16)
    local g = tonumber(hex:sub(3, 4), 16)
    local b = tonumber(hex:sub(5, 6), 16)
    if not (r and g and b) then return nil end
    return { r, g, b }
end

else_gui.setup(display, {
    { "fixed_chars", 0,    "on_resize", "Fixed Chars",        "int",   {min=0, max=1024, flag="chars", nomsg=true} },
    { "refresh_ms",  100,  nil,         "Refresh (ms)",       "int",   {min=10, max=5000, flag="refresh", nomsg=true} },
    { "noflash",     0,    nil,         "No Flash",           "check", {flag="noflash", nomsg=true} },
    { "usetheme",    0,    "repaint",   "Use Theme Colors",   "check", {frame="Appearance", flag="usetheme", nomsg=true} },
    { "transparent", 0,    "repaint",   "Transparent",        "check", {frame="Appearance", flag="transparent", nomsg=true} },
    { "bgcolor",     {224,224,224}, "repaint", "Background",  "color", {frame="Appearance", flag="bgcolor", nomsg=true, theme="bg"} },
    { "flashcolor",  {74,79,81},    "repaint", "Flash",       "color", {frame="Appearance", flag="flashcolor", nomsg=true, theme="sel"} },
    { "fgcolor",     {64,64,64},    "repaint", "Text",        "color", {frame="Appearance", flag="fgcolor", nomsg=true, theme="fg"} },
    { "fontsize",    0,    "on_resize", "Font Size (0=auto)", "int",   {min=0, max=128, flag="fontsize", nomsg=true} },
    { "hide_sel",    0,    "repaint",   "Hide Selector",      "check", {flag="hidesel", nomsg=true} },
}, {
    ["-noflash"] = function(self, atoms, i)
        self.noflash = 1
        return 0
    end,
    ["-theme"] = function(self, atoms, i)
        self.usetheme = 1
        return 0
    end,
    ["-transparent"] = function(self, atoms, i)
        self.transparent = 1
        return 0
    end,
    ["-chars"] = function(self, atoms, i)
        local v = else_gui.numbers(atoms, i, 1)
        if v[1] then
            self.fixed_chars = math.max(0, math.min(1024, math.floor(v[1])))
        end
        return #v
    end,
    ["-refresh"] = function(self, atoms, i)
        local v = else_gui.numbers(atoms, i, 1)
        if v[1] then
            self.refresh_ms = math.max(10, math.min(5000, math.floor(v[1])))
        end
        return #v
    end,
    ["-bgcolor"] = function(self, atoms, i)
        local c = hex_to_rgb(atoms[i])
        if c then self.bgcolor = c; self.usetheme = 0 end
        return 1
    end,
    ["-flashcolor"] = function(self, atoms, i)
        local c = hex_to_rgb(atoms[i])
        if c then self.flashcolor = c; self.usetheme = 0 end
        return 1
    end,
    ["-fgcolor"] = function(self, atoms, i)
        local c = hex_to_rgb(atoms[i])
        if c then self.fgcolor = c; self.usetheme = 0 end
        return 1
    end,
})

-- Reject any restored color that is not a {r, g, b} of numbers 0-255.
local function sanitize_color(c, default)
    default = default or { 0, 0, 0 }
    if type(c) == "table"
       and type(c[1]) == "number"
       and type(c[2]) == "number"
       and type(c[3]) == "number"
       and c[1] >= 0 and c[1] <= 255
       and c[2] >= 0 and c[2] <= 255
       and c[3] >= 0 and c[3] <= 255 then
        return { c[1], c[2], c[3] }
    end
    return default
end

function display:initialize(sel, atoms)
    self.inlets   = 1
    self.outlets  = 1
    self.message  = ""
    self.pending  = nil
    self.waiting  = false
    self.flashing = false
    self.clock    = pd.Clock:new():register(self, "refresh")

    self:init_args(atoms)

    self.bgcolor    = sanitize_color(self.bgcolor,    { 224, 224, 224 })
    self.flashcolor = sanitize_color(self.flashcolor, { 74, 79, 81 })
    self.fgcolor    = sanitize_color(self.fgcolor,    { 64, 64, 64 })

    self.fontsize = math.max(0, math.min(128, math.floor(self.fontsize or 0)))

    self:update_size()
    return true
end

function display:finalize()
    self.clock:destruct()
end

function display:on_resize()
    self:update_size()
    self:repaint()
end

function display:update_size()
    local cw = char_w(self.fontsize)
    local h  = box_h(self.fontsize)
    if self.fixed_chars > 0 then
        self:set_size(self.fixed_chars * cw + 8, h)
    else
        self:set_size(math.max(1, ulen(self.message)) * cw + 8, h)
    end
end

local function fmt(a)
    if type(a) == "number" and a ~= math.floor(a) then
        return string.format("%.6g", a)
    end
    return tostring(a)
end

function display:format_message(sel, atoms)
    if sel == "list" and #atoms == 0 then return "bang" end
    if sel == "bang" then return "bang" end
    if sel == "float" then return fmt(atoms[1]) end
    if sel == "toggle" then return "toggle " .. fmt(atoms[1]) end

    -- symbol / list with a single string atom: normally shown as "symbol X"
    if (sel == "symbol" or sel == "list")
       and #atoms == 1 and type(atoms[1]) == "string" then
        if self.hide_sel ~= 0 then return fmt(atoms[1]) end
        return "symbol " .. fmt(atoms[1])
    end

    local parts = {}
    -- hide only the "list" and "symbol" selectors; custom selectors stay
    local hide = self.hide_sel ~= 0 and (sel == "list" or sel == "symbol")
    if sel ~= "list" or type(atoms[1]) == "string" then
        if not hide then parts[1] = sel end
    end
    for _, a in ipairs(atoms) do parts[#parts + 1] = fmt(a) end
    return table.concat(parts, " ")
end

function display:show(sel, atoms)
    self.pending = self:format_message(sel, atoms)
    if not self.waiting then self:draw_pending() end
end

function display:draw_pending()
    local msg = self.pending
    self.pending = nil

    if self.fixed_chars > 0 then
        local max_chars = math.floor((select(1, self:get_size()) - 8) / char_w(self.fontsize))
        if ulen(msg) > max_chars then msg = usub(msg, max_chars - 1) .. "…" end
    end

    self.message  = msg
    self.flashing = self.noflash == 0

    self:update_size()
    self:repaint()
    self.waiting = true
    self.clock:delay(self.refresh_ms)
end

function display:refresh()
    self.waiting = false
    if self.pending then
        self:draw_pending()
    elseif self.flashing then
        self.flashing = false
        self:repaint()
    end
end

function display:in_1(sel, atoms)
    self:show(sel, atoms)
    self:outlet(1, sel, atoms)
end

local function contrast_color(c)
    local lum = 0.299 * c[1] + 0.587 * c[2] + 0.114 * c[3]
    return lum > 128 and {0, 0, 0} or {255, 255, 255}
end

function display:paint(g)
    local w, h = self:get_size()
    local fg = self:color("fgcolor")

    if self.flashing then
        local flashc = self:color("flashcolor")
        g:set_color(flashc[1], flashc[2], flashc[3])
        g:fill_all()
        fg = contrast_color(flashc)
    else
        self:fill_background(g, "bgcolor")
    end

    g:set_color(fg[1], fg[2], fg[3])

    local pad = self.fontsize > 0
        and math.max(1, math.floor(4 * self.fontsize / REF_FONT_SIZE + 0.5))
        or 4

    if self.fontsize > 0 then
        g:draw_text(self.message, pad, pad, w, self.fontsize)
    else
        g:draw_text(self.message, pad, pad, w)
    end
end
